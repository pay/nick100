# XMPP bot config — 5 JID × 20 nick = 100 nick total
# Salin ke .env lalu isi kredensial. JANGAN commit .env ke repo.

# Setiap JID punya 20 nick (NICKS_PER_JID), 1 MUC shared
JID1=jid1@conversations.im
PASSWORD1=ganti_password_jid1
JID2=jid2@conversations.im
PASSWORD2=ganti_password_jid2
JID3=jid3@conversations.im
PASSWORD3=ganti_password_jid3
JID4=jid4@conversations.im
PASSWORD4=ganti_password_jid4
JID5=jid5@conversations.im
PASSWORD5=ganti_password_jid5

# MUC target (shared untuk semua JID)
MUC=nama_room@conference.domain.tld

# Nick per JID (total = N_JID × NICKS_PER_JID)
NICKS_PER_JID=20

# Server (kosongkan = auto-resolve dari JID domain)
SERVER=

# Opsional: jeda antar join (detik). Naikkan kalau rate-limited
JOIN_DELAY=0.3
